      "allowed_operations": [
        "read",
        "update"
      ]
    },
    {
      "entity_name": "AuditLog",
      "allowed_operations": [
        "create",
        "read"
      ]
    },
    {
      "entity_name": "BatchAnalysisReport",
      "allowed_operations": [
        "read"
      ]
    },
    {
      "entity_name": "ClientApp",
      "allowed_operations": [
        "read"
      ]
    }
  ],
  "name": "data_guardian"
