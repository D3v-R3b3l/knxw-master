{
  "name": "Robot",
  "type": "object",
  "properties": {
    "robot_id": {
      "type": "string",
      "description": "The unique, client-defined ID for the robot.",
      "is_unique": true
    },
    "name": {
      "type": "string",
      "description": "A human-readable name for the robot."
    },
    "hmac_secret": {
      "type": "string",
      "description": "The 256-bit HMAC secret key for this robot. This should be securely generated and stored."
    },
    "status": {
      "type": "string",
      "enum": [
        "offline",
        "online",
        "connecting",
        "error"
      ],
      "default": "offline"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Arbitrary metadata for the robot, like model, location, etc."
    }
  },
  "required": [
    "robot_id",
    "name",
    "hmac_secret"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}