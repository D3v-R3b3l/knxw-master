{
  "name": "TenantWorkspace",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID this workspace belongs to"
    },
    "name": {
      "type": "string",
      "description": "Workspace name"
    },
    "description": {
      "type": "string",
      "description": "Workspace description"
    },
    "settings": {
      "type": "object",
      "properties": {
        "default_embedding_provider": {
          "type": "string",
          "enum": [
            "openai",
            "local"
          ],
          "default": "openai"
        },
        "chunk_size": {
          "type": "number",
          "default": 1000
        },
        "chunk_overlap": {
          "type": "number",
          "default": 100
        }
      },
      "default": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "org_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "org_id": "{{user.current_org_id}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "org_id": "{{user.current_org_id}}"
            },
            {
              "user_condition": {
                "role": {
                  "$in": [
                    "owner",
                    "admin",
                    "member"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}