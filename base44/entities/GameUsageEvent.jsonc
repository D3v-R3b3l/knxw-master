{
  "name": "GameUsageEvent",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Platform-level tenant identifier (req.tenantId). Not reliable for owner-scoped reads."
    },
    "client_app_id": {
      "type": "string",
      "description": "ClientApp.id resolved from the authenticated API key. Primary field for owner-scoped reads."
    },
    "owner_user_id": {
      "type": "string",
      "description": "ClientApp.owner_id at time of event. Denormalized for read performance."
    },
    "api_key_id": {
      "type": "string",
      "description": "ApiKey record ID if authenticated"
    },
    "endpoint": {
      "type": "string",
      "description": "API endpoint called"
    },
    "method": {
      "type": "string",
      "description": "HTTP method"
    },
    "status_code": {
      "type": "number",
      "description": "HTTP response status"
    },
    "latency_ms": {
      "type": "number",
      "description": "Request latency in milliseconds"
    },
    "bytes_in": {
      "type": "number",
      "description": "Request body size in bytes"
    },
    "bytes_out": {
      "type": "number",
      "description": "Response body size in bytes"
    },
    "game_context": {
      "type": "object",
      "description": "Game-specific context (game_id, session_id, platform, etc.)",
      "default": {}
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string"
    },
    "is_rate_limited": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "tenant_id",
    "endpoint",
    "method",
    "status_code",
    "timestamp"
  ],
  "indexes": [
    {
      "fields": [
        "tenant_id",
        "timestamp"
      ],
      "order": [
        "asc",
        "desc"
      ]
    },
    {
      "fields": [
        "client_app_id",
        "timestamp"
      ],
      "order": [
        "asc",
        "desc"
      ]
    },
    {
      "fields": [
        "owner_user_id",
        "timestamp"
      ],
      "order": [
        "asc",
        "desc"
      ]
    }
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}