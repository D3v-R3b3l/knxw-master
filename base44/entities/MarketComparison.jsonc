{
  "name": "MarketComparison",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the comparison (e.g. 'Tesla vs Rivian')"
    },
    "trend_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of the MarketTrends being compared"
    },
    "comparison_data": {
      "type": "object",
      "description": "AI-generated comparative analysis",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "trend_ids",
    "comparison_data",
    "created_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}