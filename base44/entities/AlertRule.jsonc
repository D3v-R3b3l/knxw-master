{
  "name": "AlertRule",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace ID (optional for org-level rules)"
    },
    "rule_name": {
      "type": "string",
      "enum": [
        "api_error_rate_spike",
        "latency_slo_breach",
        "retrieval_miss_rate"
      ],
      "description": "Type of alert rule"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this rule is active"
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "error_rate_percent": {
          "type": "number",
          "default": 2.0
        },
        "latency_ms": {
          "type": "number",
          "default": 400
        },
        "miss_rate_percent": {
          "type": "number",
          "default": 25.0
        }
      },
      "default": {}
    },
    "time_window_minutes": {
      "type": "number",
      "description": "Time window for evaluation in minutes"
    },
    "cooldown_minutes": {
      "type": "number",
      "default": 30,
      "description": "Minimum time between alerts for the same rule"
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this rule fired"
    }
  },
  "required": [
    "org_id",
    "rule_name",
    "time_window_minutes"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "org_id": "{{user.current_org_id}}"
            },
            {
              "user_condition": {
                "role": {
                  "$in": [
                    "owner",
                    "admin"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "org_id": "{{user.current_org_id}}"
            },
            {
              "user_condition": {
                "role": {
                  "$in": [
                    "owner",
                    "admin"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}