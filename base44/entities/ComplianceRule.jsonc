{
  "name": "ComplianceRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable name for this compliance rule"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what this rule detects and why"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "behavioral_sequence",
        "frequency_threshold",
        "psychographic_risk",
        "dark_pattern",
        "combined"
      ],
      "description": "Type of detection logic"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "detection_criteria": {
      "type": "object",
      "description": "Configurable detection parameters",
      "properties": {
        "event_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ordered sequence of event types that triggers the rule"
        },
        "frequency_limit": {
          "type": "object",
          "properties": {
            "event_type": {
              "type": "string"
            },
            "max_occurrences": {
              "type": "number"
            },
            "time_window_seconds": {
              "type": "number"
            }
          }
        },
        "psychographic_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trait": {
                "type": "string"
              },
              "operator": {
                "type": "string",
                "enum": [
                  "equals",
                  "greater_than",
                  "less_than",
                  "contains"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "combined_logic": {
          "type": "string",
          "description": "Complex logic combining behavioral and psychographic criteria"
        }
      }
    },
    "auto_intervention": {
      "type": "boolean",
      "default": false,
      "description": "Whether to automatically apply intervention (requires admin approval to enable)"
    },
    "default_intervention": {
      "type": "string",
      "enum": [
        "warning_message",
        "educational_nudge",
        "temporary_rate_limit",
        "account_review"
      ],
      "description": "Default intervention if auto-intervention is enabled"
    },
    "notification_channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Channels to notify when this rule triggers (email, slack, webhook)",
      "default": [
        "email"
      ]
    },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs or segments exempt from this rule",
      "default": []
    },
    "trigger_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this rule has been triggered"
    },
    "false_positive_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Calculated false positive rate from reviews"
    },
    "last_triggered": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "rule_type",
    "detection_criteria"
  ],
  "indexes": [
    {
      "fields": [
        "enabled",
        "severity"
      ],
      "order": [
        "asc",
        "desc"
      ]
    },
    {
      "fields": [
        "rule_type"
      ],
      "order": [
        "asc"
      ]
    }
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "compliance_officer"
          ]
        }
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}