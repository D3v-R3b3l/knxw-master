{
  "name": "WorkspaceSecret",
  "type": "object",
  "description": "Stores encrypted secrets for a workspace. All sensitive fields are encrypted at rest using envelope encryption with a KMS. Key rotation should be performed annually or on-demand.",
  "properties": {
    "workspace_id": {
      "type": "string",
      "description": "Foreign key to the Workspace entity."
    },
    "sdk_signing_key": {
      "type": "string",
      "description": "A securely generated secret key (e.g., 32-byte hex string) used to sign short-lived SDK tokens."
    },
    "meta_pixel_id": {
      "type": "string"
    },
    "meta_access_token": {
      "type": "string",
      "description": "Encrypted Meta CAPI Access Token."
    },
    "google_ads_customer_id": {
      "type": "string"
    },
    "google_ads_dev_token": {
      "type": "string",
      "description": "Encrypted Google Ads Developer Token."
    },
    "google_ads_conversion_action_id": {
      "type": "string",
      "description": "The ID of the specific conversion action to attribute uploads to."
    },
    "google_oauth_credentials": {
      "type": "object",
      "additionalProperties": true,
      "description": "Encrypted Google OAuth refresh tokens and metadata."
    },
    "ga4_measurement_id": {
      "type": "string"
    },
    "ga4_api_secret": {
      "type": "string",
      "description": "Encrypted GA4 Measurement Protocol API Secret."
    },
    "test_event_code": {
      "type": "string",
      "description": "Optional Meta CAPI Test Event Code."
    },
    "kms_key_id": {
      "type": "string",
      "description": "ID of the KMS key used for envelope encryption."
    },
    "twilio_account_sid": {
      "type": "string",
      "description": "Twilio Account SID"
    },
    "twilio_auth_token": {
      "type": "string",
      "description": "Encrypted Twilio Auth Token"
    },
    "twilio_from_number": {
      "type": "string",
      "description": "Default Twilio From number (E.164)"
    },
    "onesignal_app_id": {
      "type": "string",
      "description": "OneSignal App ID"
    },
    "onesignal_api_key": {
      "type": "string",
      "description": "Encrypted OneSignal REST API Key"
    }
  },
  "required": [
    "workspace_id",
    "sdk_signing_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}