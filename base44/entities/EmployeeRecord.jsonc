{
  "name": "EmployeeRecord",
  "type": "object",
  "properties": {
    "subject_id": {
      "type": "string",
      "description": "Unique ID for the employee"
    },
    "email": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "Freeform notes (e.g., feedback snippets, review highlights)"
    },
    "survey_responses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "hired_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "subject_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}