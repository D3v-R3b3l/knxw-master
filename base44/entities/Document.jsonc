{
  "name": "Document",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace ID"
    },
    "source": {
      "type": "string",
      "description": "Document source identifier"
    },
    "uri": {
      "type": "string",
      "description": "Document URI or file path"
    },
    "mime_type": {
      "type": "string",
      "description": "MIME type of the document"
    },
    "text_content": {
      "type": "string",
      "description": "Extracted text content"
    },
    "metadata": {
      "type": "object",
      "description": "Document metadata",
      "default": {}
    },
    "chunk_count": {
      "type": "number",
      "description": "Number of chunks created from this document",
      "default": 0
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "processing_error": {
      "type": "string",
      "description": "Error message if processing failed"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "org_id",
    "workspace_id",
    "source",
    "uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "org_id": "{{user.current_org_id}}"
            },
            {
              "workspace_id": "{{user.current_workspace_id}}"
            }
          ]
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "org_id": "{{user.current_org_id}}"
            },
            {
              "workspace_id": "{{user.current_workspace_id}}"
            },
            {
              "user_condition": {
                "role": {
                  "$in": [
                    "owner",
                    "admin",
                    "member"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}