{
  "name": "AdaptationRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable rule name"
    },
    "description": {
      "type": "string",
      "description": "Optional summary of what this rule does"
    },
    "client_app_id": {
      "type": "string",
      "description": "Client application this rule belongs to"
    },
    "owner_id": {
      "type": "string",
      "description": "Base44 user id that owns the rule"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active"
      ],
      "default": "draft"
    },
    "psychographic_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "operator": {
            "type": "string",
            "enum": [
              "equals",
              "contains"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "component_target": {
      "type": "object",
      "properties": {
        "component_name": {
          "type": "string"
        },
        "component_type": {
          "type": "string",
          "enum": [
            "text",
            "button",
            "layout",
            "card",
            "modal",
            "banner"
          ]
        }
      },
      "default": {}
    },
    "variant_mapping": {
      "type": "object",
      "properties": {
        "variant_name": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "cta_label": {
          "type": "string"
        },
        "layout_style": {
          "type": "string",
          "enum": [
            "default",
            "compact",
            "trust_heavy",
            "bold"
          ]
        }
      },
      "default": {}
    }
  },
  "required": [
    "name",
    "client_app_id",
    "owner_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}