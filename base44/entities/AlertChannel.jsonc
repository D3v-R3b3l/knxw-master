{
  "name": "AlertChannel",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "workspace_id": {
      "type": "string",
      "description": "Workspace ID (optional for org-level channels)"
    },
    "channel_type": {
      "type": "string",
      "enum": [
        "email",
        "slack",
        "sms"
      ],
      "description": "Type of notification channel"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name for the channel"
    },
    "config": {
      "type": "object",
      "description": "Channel-specific configuration",
      "properties": {
        "email_addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slack_webhook_url": {
          "type": "string"
        },
        "phone_numbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "default": {}
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this channel is active"
    },
    "rule_filters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which alert rules trigger notifications to this channel",
      "default": []
    }
  },
  "required": [
    "org_id",
    "channel_type",
    "name",
    "config"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "org_id": "{{user.current_org_id}}"
            },
            {
              "user_condition": {
                "role": {
                  "$in": [
                    "owner",
                    "admin"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "org_id": "{{user.current_org_id}}"
            },
            {
              "user_condition": {
                "role": {
                  "$in": [
                    "owner",
                    "admin"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}