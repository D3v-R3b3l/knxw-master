          "type": "number"
        },
        "cohort_fatigue_delta": {
          "type": "number"
        }
      }
    },
    "ethical_penalty": {
      "type": "number"
    }
  },
  "required": [
    "intervention_id",
    "harm_proxy_scores",
    "ethical_penalty"
  ]
}