{
  "name": "Org",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization name"
    },
    "settings": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "default": "UTC"
        },
        "retention_days": {
          "type": "number",
          "default": 90
        }
      },
      "default": {}
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "deleted"
      ],
      "default": "active"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}