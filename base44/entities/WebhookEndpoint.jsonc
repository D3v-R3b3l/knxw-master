{
  "name": "WebhookEndpoint",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID this webhook endpoint belongs to"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name for the webhook endpoint"
    },
    "url": {
      "type": "string",
      "description": "Target URL for webhook deliveries (must be HTTPS)"
    },
    "secret": {
      "type": "string",
      "description": "Optional signing secret for HMAC-SHA256 payload verification"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "profile.updated",
          "insight.created",
          "recommendation.generated"
        ]
      },
      "description": "Event types this endpoint subscribes to",
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused"
      ],
      "default": "active",
      "description": "Webhook endpoint status"
    },
    "failure_count": {
      "type": "number",
      "default": 0,
      "description": "Consecutive delivery failure count"
    },
    "last_delivery_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful delivery timestamp"
    }
  },
  "required": [
    "tenant_id",
    "name",
    "url",
    "events"
  ],
  "indexes": [
    {
      "fields": [
        "tenant_id",
        "status"
      ],
      "order": [
        "asc",
        "asc"
      ]
    }
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}