{
  "name": "BatchAnalysisReport",
  "type": "object",
  "properties": {
    "analysis_type": {
      "type": "string",
      "enum": [
        "professional_report",
        "psychographic_clustering",
        "behavioral_trend_analysis",
        "churn_prediction_analysis",
        "psychographic_comparison",
        "cohort_analysis"
      ],
      "description": "Type of batch analysis performed."
    },
    "org_id": {
      "type": "string",
      "description": "Org this report belongs to. Nullable during Stage 1 backfill."
    },
    "client_app_id": {
      "type": "string",
      "description": "ID of the ClientApp this report belongs to."
    },
    "parameters": {
      "type": "object",
      "description": "Parameters used for the analysis.",
      "properties": {
        "client_app_id": {
          "type": "string"
        },
        "segment_count": {
          "type": "number"
        },
        "time_window_days": {
          "type": "number"
        },
        "include_reasoning": {
          "type": "boolean"
        },
        "comparison_segments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "results": {
      "type": "object",
      "description": "Complete analysis results including clusters, trends, and insights."
    },
    "execution_time_seconds": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ]
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "analysis_type",
    "results",
    "status"
  ],
  "indexes": [
    {
      "fields": [
        "client_app_id",
        "created_date"
      ],
      "order": [
        "asc",
        "desc"
      ]
    },
    {
      "fields": [
        "org_id",
        "created_date"
      ],
      "order": [
        "asc",
        "desc"
      ]
    },
    {
      "fields": [
        "is_demo",
        "created_date"
      ],
      "order": [
        "asc",
        "desc"
      ]
    }
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}